# ============================================================
#  MAC Spoofing Platform — Variables d'environnement
#  NE JAMAIS COMMITTER le fichier .env réel
# ============================================================

# --- Général ---
APP_NAME="MAC Spoofing Platform"
APP_ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- Sécurité / JWT ---
# Générer avec : openssl rand -hex 64
SECRET_KEY=CHANGE_ME_openssl_rand_hex_64
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- CORS ---
BACKEND_CORS_ORIGINS=[http://localhost:3000,http://localhost:5173,http://localhost:8000]

# --- PostgreSQL ---
POSTGRES_USER=mac_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=mac_spoofing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL async (asyncpg) utilisée par FastAPI
DATABASE_URL=postgresql+asyncpg://mac_admin:CHANGE_ME_strong_password@postgres:5432/mac_spoofing
# URL sync (psycopg2) utilisée par Celery + Alembic
DATABASE_URL_SYNC=postgresql+psycopg2://mac_admin:CHANGE_ME_strong_password@postgres:5432/mac_spoofing

# --- Redis (broker Celery + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Worker MAC Spoofing ---
DEFAULT_INTERFACE=eth0
IP_BIN=/usr/sbin/ip
# Mode dry-run global (aucune modif système). Mettre à `false` pour activer réellement.
MAC_SPOOF_DRY_RUN=true
# Rate-limit : intervalle min. entre 2 spoofs par utilisateur (secondes)
MAC_SPOOF_RATE_LIMIT_SECONDS=30
# Timeout (secondes) de chaque commande `ip`
MAC_SPOOF_CMD_TIMEOUT=5
# Whitelist d'interfaces autorisées (vide = toutes celles validées par le service)
ALLOWED_INTERFACES=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
